<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="subject-title mb-0"><%= @paragraph.title %></h2>
    <%= link_to "Back to Topics", subject_chapter_paragraphs_path(@chapter.subject, @chapter), class: "btn btn-secondary", data: { turbo: false } %>
  </div>

  <% fixed_paragraph_color = "hsl(226, 48%, 84%)" %>
  <div class="card mb-5 p-4 shadow-sm border-0" style="background-color: <%= fixed_paragraph_color %>; border-radius: 12px;">
    <div class="card-body">
      <h5 class="card-title text-dark mb-3">Content</h5>
      <div class="card-text text-dark" style="font-size: 1.05rem; line-height: 1.7;"><%= raw @paragraph.content %></div>
    </div>
  </div>

  <h3 class="mb-4 fw-bold text-dark">Flashcards</h3>
  <% if @paragraph.questions.any? %>
    <div class="row">
      <% @paragraph.questions.each do |question| %>
        <% random_light_color = "hsl(#{rand(360)}, #{rand(30..70)}%, #{rand(80..95)}%)" %>
        <div class="col-md-4 mb-4">
          <div class="question-card" data-question-id="<%= question.id %>" data-answers='<%= question.answers.map(&:answer).to_json %>' style="background-color: <%= random_light_color %>;">
            <div class="card-content">
              <h5 class="card-title mb-2 text-dark"><%= question.question.html_safe %></h5>
              <p class="card-text-hint text-muted">Click to reveal answer</p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5 bg-white rounded border" style="border-color: #e2e8f0;">
      <i class="bi bi-card-text fs-1 text-muted mb-3"></i>
      <p class="lead text-muted">No flashcards generated yet.</p>
    </div>
  <% end %>

  <div id="overlay" class="modal-overlay"></div>
  <div id="flipped-card-container" class="modal-card-container"></div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const questionCards = document.querySelectorAll(".question-card");
    const overlay = document.getElementById("overlay");
    const flippedCardContainer = document.getElementById("flipped-card-container");

    questionCards.forEach(card => {
      card.addEventListener("click", function () {
        const questionText = this.querySelector('.card-title').textContent.trim();
        const backgroundColor = this.style.backgroundColor;
        const answers = JSON.parse(this.dataset.answers || "[]");

        let answerHtml;
        if (answers.length > 0) {
          answerHtml = `<ul class="list-unstyled mb-0 text-dark">` +
            answers.map(a => `<li class="mb-2">${a}</li>`).join("") +
            `</ul>`;
        } else {
          answerHtml = `<p class="text-muted">No answers available yet.</p>`;
        }

        const baseStyle = `position:absolute;top:0;left:0;width:100%;height:100%;border-radius:16px;overflow:hidden;display:flex;align-items:center;justify-content:center;background-color:${backgroundColor};box-shadow:0 20px 25px -5px rgba(0,0,0,0.1);transition:opacity 0.3s ease;`;

        const flipCardHtml = `
          <div id="modal-flip-card" style="position:relative;width:100%;height:300px;cursor:pointer;border-radius:16px;">
            <div id="face-front" style="${baseStyle} z-index:2;">
              <div class="card-content">
                <h5 class="card-title px-3 text-dark">${questionText}</h5>
                <p class="card-text-hint text-muted">Click to see answer</p>
              </div>
            </div>
            <div id="face-back" style="${baseStyle} z-index:1;opacity:0;border:2px solid #3b82f6;">
              <div class="card-content">
                ${answerHtml}
              </div>
            </div>
          </div>
        `;

        flippedCardContainer.innerHTML = flipCardHtml;
        overlay.style.display = "block";
        flippedCardContainer.style.display = "flex";
        document.body.style.overflow = "hidden";

        let flipped = false;
        const flipCard = document.getElementById("modal-flip-card");
        const front = document.getElementById("face-front");
        const back  = document.getElementById("face-back");

        flipCard.addEventListener("click", function (e) {
          e.stopPropagation();
          flipped = !flipped;
          if (flipped) {
            front.style.opacity = "0";
            front.style.zIndex = "1";
            back.style.opacity = "1";
            back.style.zIndex = "2";
          } else {
            front.style.opacity = "1";
            front.style.zIndex = "2";
            back.style.opacity = "0";
            back.style.zIndex = "1";
          }
        });

        overlay.addEventListener("click", closeFlippedCard, { once: true });
      });
    });


    function closeFlippedCard() {
      overlay.style.display = "none";
      flippedCardContainer.style.display = "none";
      document.body.style.overflow = "auto";
    }
  });
</script>